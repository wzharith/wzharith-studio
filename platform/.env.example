# ──────────────────────────────────────────────────────────────────────────
# WZHarith Studio — environment template
# Copy to platform/.env.local and fill values. Never commit .env.local.
# ──────────────────────────────────────────────────────────────────────────

# Database — Neon Postgres
# Console: https://console.neon.tech/
# Format: postgres://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
DATABASE_URL=

# Auth — server-only (no NEXT_PUBLIC_ prefix; never exposed to the browser)
# INVOICE_PASSWORD: the studio operator's login password
# SESSION_SECRET: random 32+ bytes; used to sign session JWT cookies
INVOICE_PASSWORD=
SESSION_SECRET=

# Google Calendar API (service-account auth)
# 1) Create a Google Cloud project, enable "Google Calendar API"
# 2) Create a service account, download the JSON key
# 3) Share your target calendar (Settings → Share → Add people) with the
#    service account email, with "Make changes to events" permission
# 4) Use the calendar ID from Settings → Integrate calendar
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste private_key from JSON. Newlines as literal "\n" are also accepted.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional — kept only for the legacy Sheets-based migration script.
# Set this temporarily to run `npm run migrate:sheets`, then unset.
# NEXT_PUBLIC_GOOGLE_SCRIPT_URL=
